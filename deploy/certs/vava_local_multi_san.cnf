[req]
default_bits = 2048
default_md = sha256
distinguished_name = dn
req_extensions = req_ext
prompt = no

[dn]
CN = *.sunvalleycloud.com
O = VAVA Local Test
OU = Local Cloud

[req_ext]
subjectAltName = @alt_names

[v3_server]
basicConstraints = critical, CA:FALSE
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = @alt_names

[alt_names]
DNS.1 = *.sunvalleycloud.com
DNS.2 = sunvalleycloud.com
DNS.3 = *.vava.com
DNS.4 = vava.com
DNS.5 = mi-api-pro.sunvalleycloud.com
DNS.6 = iot-api.sunvalleycloud.com
DNS.7 = h5.sunvalleycloud.com
DNS.8 = localhost
IP.1 = 127.0.0.1
